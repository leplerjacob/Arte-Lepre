---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import EstimateForm from "../components/EstimateForm.astro";
import ceiling from "../assets/images/banner_3.jpeg";
import map from "../assets/images/quarter-map.png";
import { locations, site } from "../data/site";
---

<BaseLayout
  title="Request an Estimate"
  description={`Request a restoration estimate from Arte Lepre in Kensington, MD. Send photos of your piece, or call Fabio Lepre at ${site.phone.display}.`}
  businessSchema
>
  <PageHero
    eyebrow="Contact"
    title="Request an <em>estimate</em>"
    lede="Tell Fabio about your piece and he'll reply directly with his assessment. Prefer to talk? Call anytime."
    image={ceiling}
  />

  <section class="section">
    <div class="wrap contact">
      <div class="card" id="estimate" data-reveal>
        <p class="eyebrow">Estimate Request</p>
        <h2>Tell us about your <em>piece</em></h2>
        <p class="intro">Fields marked <span class="req">*</span> are required. Fabio replies to the email address you give.</p>
        <EstimateForm />
      </div>

      <aside class="side">
        <div class="call" data-reveal>
          <p class="eyebrow">Prefer to Talk?</p>
          <a class="call__number" href={site.phone.href}>{site.phone.display}</a>
          <p>Call Fabio directly to discuss your piece or book a visit. Consultations by appointment.</p>
          <a class="btn btn--gold" href={site.phone.href}>Call now</a>
        </div>

        <dl data-reveal>
          <div>
            <dt>Workshop</dt>
            <dd>
              <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
                {site.address.street}<br />
                {site.address.city}, {site.address.region} {site.address.postalCode}
              </a>
            </dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>By appointment</dd>
          </div>
          <div>
            <dt>Languages</dt>
            <dd>English · Italiano</dd>
          </div>
        </dl>

        <a class="map" href={site.mapsUrl} target="_blank" rel="noopener noreferrer" data-reveal>
          <Image src={map} alt="Map of the Kensington, MD workshop location" widths={[480, 960]} sizes="(max-width: 960px) 92vw, 420px" format="webp" />
          <span>Open in Google Maps &#8599;</span>
        </a>

        <div class="locations" data-reveal>
          <p class="eyebrow">The Family Workshops</p>
          <ul>
            {
              locations.map(({ label, address, person }) => (
                <li>
                  <strong>{label}</strong> · {person}
                  <br />
                  <span>{address}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .card {
    position: relative;
    padding: clamp(1.75rem, 4.5vw, 3.25rem);
    background: var(--parchment);
    border: 1px solid var(--rule);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 7px;
    border: 1px solid rgb(148 114 47 / 0.18);
    pointer-events: none;
  }
  .card h2 { margin-top: 0.5rem; font-size: var(--step-3); }
  .intro { margin: 0.75rem 0 2rem; color: var(--text-soft); font-size: 0.95rem; }
  .req { color: var(--gold-deep); }

  .side { display: grid; gap: 2.25rem; }
  .call {
    padding: 2rem;
    background: var(--navy) url("../assets/patterns/parquetry.svg");
    background-size: 60px 104px;
    color: var(--on-navy);
  }
  .call .eyebrow { color: var(--gold); }
  .call__number {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    color: var(--ivory);
    text-decoration: none;
  }
  .call p { margin-top: 0.75rem; font-size: 0.95rem; }
  .call .btn { margin-top: 1.25rem; }

  dl { display: grid; gap: 1rem; }
  dl div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); }
  dt {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-deep);
    padding-top: 0.3rem;
  }
  dd a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  dd a:hover { color: var(--gold-deep); border-color: var(--gold-deep); }

  .map { position: relative; display: block; overflow: hidden; border: 1px solid var(--rule); }
  .map img { width: 100%; aspect-ratio: 16 / 6; object-fit: cover; transition: transform 0.6s var(--ease); }
  .map:hover img { transform: scale(1.05); }
  .map span {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.4rem 0.75rem;
    background: var(--navy);
    color: var(--ivory);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .locations ul { list-style: none; padding: 0; margin-top: 0.75rem; display: grid; gap: 0.9rem; font-size: 0.95rem; }
  .locations strong { font-family: var(--font-display); font-size: var(--step-1); color: var(--navy); }
  .locations span { color: var(--text-soft); }

  @media (max-width: 960px) {
    .contact { grid-template-columns: 1fr; }
  }
</style>
