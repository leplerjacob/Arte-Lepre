---
import { Image, getImage } from "astro:assets";
import type { Piece } from "../data/pieces";
import { site } from "../data/site";

interface Props {
  pieces: Piece[];
  /** Show a "Call to Purchase" button under each description. */
  forSale?: boolean;
}
const { pieces, forSale = false } = Astro.props;

// Full-size versions for the lightbox (the originals are up to 3000px PNGs).
const items = await Promise.all(
  pieces.map(async (piece) => ({
    ...piece,
    photos: await Promise.all(
      piece.images.map(async (src) => ({
        src,
        full: (await getImage({ src, width: Math.min(src.width, 1800), format: "webp", quality: 82 })).src,
      })),
    ),
  })),
);
---

<ul class="pieces">
  {
    items.map((piece) => (
      <li class="piece">
        <div class="text">
          <h3>{piece.title}</h3>
          <p>{piece.description}</p>
          {forSale && (
            <a class="btn btn--outline" href={site.phone.href}>
              Call to Purchase
            </a>
          )}
        </div>
        <div class:list={["photos", { "photos--fade": piece.photos.length > 1 }]}>
          {piece.photos.map((photo, i) => (
            <a
              class:list={["photo", { "is-active": i === 0 }]}
              href={photo.full}
              data-lightbox
              data-caption={piece.photos.length > 1 ? `${piece.title} (${i + 1} of ${piece.photos.length})` : piece.title}
            >
              <Image
                src={photo.src}
                alt={piece.photos.length > 1 ? `${piece.title}, view ${i + 1}` : piece.title}
                widths={[300, 450, 900]}
                sizes="(max-width: 768px) 80vw, 450px"
                format="webp"
              />
            </a>
          ))}
        </div>
      </li>
    ))
  }
</ul>

<script>
  // Pieces with an open + closed photo cross-fade between them, all in step, every 4s.
  const sets = [...document.querySelectorAll<HTMLElement>(".photos--fade")];
  if (sets.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let tick = 0;
    setInterval(() => {
      if (document.hidden) return;
      tick++;
      sets.forEach((set) => {
        const photos = set.querySelectorAll(".photo");
        photos.forEach((p, i) => p.classList.toggle("is-active", i === tick % photos.length));
      });
    }, 4000);
  }
</script>

<style>
  .pieces {
    list-style: none;
    padding: 0 1.5rem;
  }

  .piece {
    display: grid;
    grid-template-columns: 300px 1px minmax(0, 450px);
    justify-content: center;
    align-items: center;
    gap: 0 3rem;
    margin-top: 3.5rem;
  }
  /* vertical rule between the text and the photo, as on the original site */
  .piece::before {
    content: "";
    grid-column: 2;
    grid-row: 1;
    align-self: stretch;
    background: var(--rule);
  }
  .text { grid-column: 1; grid-row: 1; }
  .photos { grid-column: 3; grid-row: 1; }

  h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.35;
    color: var(--navy);
    margin-bottom: 0.75rem;
  }
  p {
    font-size: 0.95rem;
    color: #333;
  }
  .btn { margin-top: 1.25rem; }

  /* Photos keep their real proportions: capped at 450px wide and 560px tall. */
  .photos {
    display: grid;
    justify-items: center;
  }
  .photo {
    grid-area: 1 / 1;
    display: block;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 6px 24px rgb(29 51 86 / 0.18);
  }
  .photo img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 560px;
    transition: transform 0.5s var(--ease);
  }
  .photo:hover img { transform: scale(1.03); }

  .photos--fade .photo {
    opacity: 0;
    transition: opacity 1s var(--ease);
  }
  .photos--fade .photo.is-active { opacity: 1; }
  .photos--fade .photo:not(.is-active) { pointer-events: none; }

  @media (max-width: 768px) {
    .piece {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      margin-top: 2.5rem;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--rule);
    }
    .piece::before { display: none; }
    .text, .photos { grid-column: 1; grid-row: auto; }
    .text { max-width: 34rem; margin-inline: auto; text-align: center; }
    .photo img { max-height: 70vh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo img, .photos--fade .photo { transition: none; }
  }
</style>
