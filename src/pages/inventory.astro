---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Catalogue from "../components/Catalogue.astro";
import { inventoryPieces } from "../data/pieces";
import { site } from "../data/site";
---

<BaseLayout
  title="Antiques for Sale"
  description="Restored antique furniture for sale from Arte Lepre: Dutch, German, Italian and Continental bureaus, commodes and cabinets. Call to enquire."
>
  <PageHero
    eyebrow="Antiques for Sale"
    title="The <em>collection</em>"
    lede={`Period furniture restored in our workshop and available to acquire. Viewings by appointment — call ${site.phone.display}.`}
  />
  <section class="section">
    <div class="wrap">
      <Catalogue pieces={inventoryPieces} />
    </div>
  </section>
</BaseLayout>
