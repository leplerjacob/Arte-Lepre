---
import { Image } from "astro:assets";
import logo from "../assets/images/Logo.png";
import { navLinks, site } from "../data/site";
import { url } from "../lib/paths";

const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<div class="topbar">
  <div class="wrap topbar__inner">
    <span>Napoli &nbsp;·&nbsp; Washington, D.C. &nbsp;·&nbsp; Est. {site.since}</span>
    <span>By appointment &nbsp;·&nbsp; <a href={site.phone.href}>{site.phone.display}</a></span>
  </div>
</div>

<header class="header" data-header>
  <div class="wrap header__inner">
    <a class="logo" href={url("/")} aria-label="Arte Lepre home">
      <Image src={logo} alt="Arte Lepre, Antique Restoration & Conservation, since 1959" widths={[210, 420]} sizes="210px" loading="eager" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          navLinks.slice(1).map(({ href, label }) => (
            <li>
              <a href={href} aria-current={current === href ? "page" : undefined}>{label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--gold nav__cta" href={url("/contact/")}>Book a Visit</a>
    </nav>

    <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" hidden>
  <nav aria-label="Mobile">
    <ul>
      {
        navLinks.map(({ href, label }, i) => (
          <li style={`--i:${i}`}>
            <a href={href} aria-current={current === href ? "page" : undefined}>{label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu__foot">
    <p class="eyebrow">By appointment</p>
    <a href={site.phone.href}>{site.phone.display}</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const burger = header.querySelector<HTMLButtonElement>(".burger")!;
  const menu = document.getElementById("menu")!;

  // Compact, shadowed header once the page has scrolled.
  const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  function setOpen(open: boolean) {
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.documentElement.classList.toggle("menu-open", open);
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add("is-open"));
    } else {
      menu.classList.remove("is-open");
      setTimeout(() => {
        if (!menu.classList.contains("is-open")) menu.hidden = true;
      }, 350);
    }
  }

  burger.addEventListener("click", () => setOpen(burger.getAttribute("aria-expanded") !== "true"));
  menu.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("is-open")) {
      setOpen(false);
      burger.focus();
    }
  });
  matchMedia("(min-width: 961px)").addEventListener("change", (e) => e.matches && setOpen(false));
</script>

<style>
  /* ---------- top utility bar ---------- */
  .topbar {
    background: var(--navy-deep);
    color: rgb(233 228 216 / 0.75);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .topbar__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
  }
  .topbar a { color: var(--gold); text-decoration: none; }
  .topbar a:hover { color: var(--ivory); }

  /* ---------- main bar ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy);
    transition: box-shadow 0.3s var(--ease);
  }
  /* double gold "stringing" line under the header */
  .header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 4px;
    border-top: 1px solid var(--gold-line);
    border-bottom: 1px solid rgb(214 175 99 / 0.25);
    background: var(--navy);
  }
  .header.is-scrolled { box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5); }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 112px;
    transition: height 0.3s var(--ease);
  }
  .header.is-scrolled .header__inner { height: var(--header-h); }

  .logo img {
    width: 210px;
    height: auto;
    transition: width 0.3s var(--ease);
  }
  .header.is-scrolled .logo img { width: 150px; }

  .nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }
  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }
  .nav ul a {
    position: relative;
    display: block;
    padding-block: 0.5rem;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.74rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-navy);
    transition: color 0.2s var(--ease);
  }
  .nav ul a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0.2em;
    bottom: 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.3s var(--ease);
  }
  .nav ul a:hover, .nav ul a[aria-current="page"] { color: var(--gold); }
  .nav ul a:hover::after, .nav ul a[aria-current="page"]::after { transform: scaleX(1); }
  .nav__cta { padding: 0.8rem 1.4rem; }

  .burger { display: none; }

  /* ---------- tablet & phone ---------- */
  @media (max-width: 1100px) {
    .nav ul { gap: 1.4rem; }
    .nav { gap: 1.5rem; }
  }

  @media (max-width: 960px) {
    .topbar { display: none; }
    .nav { display: none; }
    .header__inner { height: 76px; }
    .header.is-scrolled .header__inner { height: 68px; }
    .logo img, .header.is-scrolled .logo img { width: 150px; }

    .burger {
      position: relative;
      z-index: 70;
      display: grid;
      place-content: center;
      gap: 7px;
      width: 46px;
      height: 46px;
      padding: 0;
      border: 1px solid var(--gold-line);
      background: transparent;
      cursor: pointer;
    }
    .burger span {
      display: block;
      width: 22px;
      height: 1.5px;
      background: var(--gold);
      transition: transform 0.35s var(--ease);
    }
    .burger[aria-expanded="true"] span:first-child { transform: translateY(4.25px) rotate(45deg); }
    .burger[aria-expanded="true"] span:last-child { transform: translateY(-4.25px) rotate(-45deg); }
  }

  /* ---------- full-screen mobile menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(76px + 3rem) var(--gutter) 2.5rem;
    background: var(--navy) url("../assets/patterns/parquetry.svg");
    background-size: 60px 104px;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .menu.is-open { opacity: 1; }
  .menu ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .menu li {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    transition-delay: calc(var(--i) * 60ms + 100ms);
  }
  .menu.is-open li { opacity: 1; transform: none; }
  .menu ul a {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 9vw, 3rem);
    line-height: 1.25;
    color: var(--ivory);
    text-decoration: none;
  }
  .menu ul a[aria-current="page"] { color: var(--gold); font-style: italic; }
  .menu__foot {
    display: grid;
    gap: 0.35rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--gold-line);
    color: var(--on-navy);
  }
  .menu__foot a { color: var(--on-navy); text-decoration: none; }
  .menu__foot .eyebrow { color: var(--gold); }
  :global(html.menu-open) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .header, .header__inner, .logo img, .menu, .menu li, .burger span { transition: none; }
  }
</style>
