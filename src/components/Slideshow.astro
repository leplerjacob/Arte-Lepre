---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  /** Milliseconds each slide stays on screen. */
  interval?: number;
}
const { images, interval = 3500 } = Astro.props;
---

<div class="slideshow" data-interval={interval}>
  {
    images.map((src, i) => (
      <Image
        class:list={["slide", { "is-active": i === 0 }]}
        src={src}
        alt=""
        widths={[640, 1024, 1600]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        loading={i === 0 ? "eager" : "lazy"}
        fetchpriority={i === 0 ? "high" : "auto"}
      />
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>(".slideshow").forEach((show) => {
    const slides = [...show.querySelectorAll<HTMLElement>(".slide")];
    if (slides.length < 2 || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      slides[i].classList.remove("is-active");
      i = (i + 1) % slides.length;
      slides[i].classList.add("is-active");
    }, Number(show.dataset.interval));
  });
</script>

<style>
  .slideshow {
    position: relative;
    height: 400px;
    overflow: hidden;
    background: var(--navy);
    border-bottom: 1px solid var(--navy);
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .slide.is-active { opacity: 1; }

  @media (max-width: 600px) {
    .slideshow { height: 220px; }
  }
</style>
